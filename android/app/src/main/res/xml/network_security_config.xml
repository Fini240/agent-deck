<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system CAs only. No user-installed CAs, no debug overrides, no pinning bypass. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
